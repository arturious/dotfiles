	name = arx
	email = 81509503+arturious@users.noreply.github.com

[github]
	user = arturious

[init]
	defaultBranch = main

[core]
	editor = nvim
	ignorecase = false
	pager = delta

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = false

[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
	ui = auto

[diff]
	tool = nvimdiff

[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
	path =

[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true

[include]
	path = ~/.config/git/aliases.gitconfig
	path = ~/.config/git/ghq.gitconfig
	path = ~/.config/git/delta.gitconfig
	# Machine-only settings, not in the repo.
	path = ~/.config/git/local.gitconfig
