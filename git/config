# Deployed to ~/.config/git/config (git reads it when ~/.gitconfig is absent).
[user]
	name = arx
	email = 81509503+arturious@users.noreply.github.com

[github]
	user = arturious

[init]
	defaultBranch = main

[core]
	ignorecase = false
	pager = delta

[push]
	default = simple
	autoSetupRemote = true

[pull]
	rebase = false

[color]
	ui = auto

[include]
	path = ~/.config/git/aliases.gitconfig
	path = ~/.config/git/ghq.gitconfig
	path = ~/.config/git/delta.gitconfig
	# Machine-only settings, not in the repo.
	path = ~/.config/git/local.gitconfig
