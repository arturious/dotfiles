{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Cursor reads its settings only from ~/Library/Application Support/Cursor/User.
# The real files live in ~/.config/cursor (dot_config/cursor in this repo);
# symlink them into place and install any missing extensions.
# Runs on every apply: a Cursor reinstall can replace the symlink with a fresh file.
set -euo pipefail

src="$HOME/.config/cursor"
user_dir="$HOME/Library/Application Support/Cursor/User"
mkdir -p "$user_dir"

for f in settings.json keybindings.json; do
  [ -e "$src/$f" ] || continue
  dest="$user_dir/$f"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src/$f" ]; then
    continue
  fi
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    mv "$dest" "$dest.bak.$(date +%Y%m%d%H%M%S)"
  fi
  ln -sfn "$src/$f" "$dest"
  echo "Cursor: $dest -> $src/$f"
done

cursor_bin="/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
command -v cursor >/dev/null 2>&1 && cursor_bin="$(command -v cursor)"
if [ -x "$cursor_bin" ] && [ -f "$src/extensions.txt" ]; then
  installed="$("$cursor_bin" --list-extensions 2>/dev/null || true)"
  while IFS= read -r ext; do
    [ -z "$ext" ] && continue
    if ! grep -qixF "$ext" <<<"$installed"; then
      echo "Cursor: installing $ext"
      "$cursor_bin" --install-extension "$ext" >/dev/null 2>&1 || echo "Cursor: !! could not install $ext"
    fi
  done < "$src/extensions.txt"
fi
{{ end -}}
