#!/usr/bin/env zsh
# Ctrl+A custom command for lazygit (see ~/Library/Application Support/lazygit/config.yml).
# Runs with output: terminal (not a tmux popup - tmux can't stack a second,
# independent popup on top of an existing one, e.g. lazygit opened via
# prefix+g; it just modifies that same popup instead, ignoring -w/-h/-d).
# Suspending to the actual pane works regardless of how lazygit was opened,
# and lets us draw our own animated spinner and an editable prompt, neither
# of which lazygit's own `prompts` system supports (its initialValue/
# runCommand blocks the UI with no loading indicator - confirmed by reading
# its Go source).
#
# zsh, not bash: editing needs a prefilled, in-place-editable prompt. bash's
# `read -i` (which does that) needs bash 4+, but macOS ships bash 3.2 (last
# GPLv2 release) as /bin/bash with no `-i` support. zsh's builtin `vared`
# does the same job without that dependency.
set -e
setopt pipefail

# lazygit itself hardcodes a blue "+ <command>" line before running any
# output: terminal command (pkg/gui/gui.go, runSubprocess) - not something
# we can suppress via config. Clearing the screen first wipes it.
clear

label=$'\033[38;2;217;119;87m'
reset=$'\033[0m'
printf '%sAI Commit Message%s\n\n' "$label" "$reset"

if git diff --cached --quiet; then
    echo "Nothing staged - stage changes first."
    read -k 1 -s "?Press any key to close..."
    echo
    exit 0
fi

msg_file=$(mktemp)
trap 'rm -f "$msg_file"' EXIT

# Paint "Esc to cancel" once, bottom-right, then leave the cursor where it
# was - it stays put while everything above it redraws via \r.
hint="Esc to cancel"
printf '\0337\033[%d;%dH%s\0338' "$(tput lines)" "$(( $(tput cols) - ${#hint} - 1 ))" "$hint"

# --safe-mode: skips CLAUDE.md/skills/plugins/hooks/MCP servers, none of
# which this one-line generation needs - shaves a few seconds off startup
# without touching auth (unlike --bare, which needs an API key and breaks
# the OAuth/subscription login this account uses).
git diff --cached | claude --model haiku --safe-mode -p "Write ONE single-line git commit message for this diff, following the Conventional Commits format (type(scope): summary). No body, no newlines, no code fences, no surrounding quotes - output ONLY that single line." >"$msg_file" &
pid=$!

# Same frame set/order as gui.spinner in lazygit-config.yml: 0,1,2,3,4,5,5,4,3,2,1,0.
frames=('·' '✢' '✳' '✶' '✻' '✽' '✽' '✻' '✶' '✳' '✢' '·')
n=0
cancelled=0
while kill -0 "$pid" 2>/dev/null; do
    idx=$(( (n % ${#frames[@]}) + 1 ))
    printf '\r%s%s Generating commit message...%s' "$label" "${frames[idx]}" "$reset"
    n=$((n + 1))
    if read -t 0.12 -k 1 key 2>/dev/null && [[ "$key" == $'\e' ]]; then
        kill "$pid" 2>/dev/null || true
        cancelled=1
        break
    fi
done

if [ "$cancelled" -eq 1 ]; then
    printf '\r\033[KCancelled.\n'
    exit 0
fi
wait "$pid"
printf '\r\033[K'

msg=$(head -1 "$msg_file")

# Bind Esc, during vared only, to abort editing without committing.
# `zle send-break` (Ctrl-C's usual widget) looks like the obvious choice
# here, but it unwinds the whole script - even past `set -e`/`|| true` -
# instead of just making vared return non-zero. Clearing the buffer and
# accepting it is a clean way to make vared return normally instead.
cancel_edit() {
    cancelled=1
    BUFFER=""
    zle accept-line
}
zle -N cancel_edit
bindkey '\e' cancel_edit

vared -p "Commit message: " msg
bindkey -r '\e'

if [ "$cancelled" -eq 1 ]; then
    echo "Cancelled."
    exit 0
fi

if [ -z "$msg" ]; then
    echo "Empty message - commit aborted."
    read -k 1 -s "?Press any key to close..."
    echo
    exit 0
fi

git commit -m "$msg"
