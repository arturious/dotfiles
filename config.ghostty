theme = Solarized Dark Patched
background-opacity = 0.9
background-blur-radius = 20
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 14
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1s
font-feature = ss02
macos-window-buttons = hidden
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-icon = custom-style
macos-icon-frame = aluminum
macos-icon-ghost-color = #002b36
macos-icon-screen-color = #002b36
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = cmd+[=text:\x1ep
keybind = cmd+]=text:\x1en

# Cmd+P sends our tmux prefix key (see tmux.conf: prefix C-]) instead of the
# OS "Print" action. Single byte (0x1D, i.e. literal Ctrl+]), not the old
# 2-byte user-key sequence (\x1dp) - multi-byte user-keys stop registering
# once an interactive tmux popup (e.g. tmux-claude-session-manager's) grabs
# input, while a single control byte like this keeps working (confirmed by
# testing prefix2 'C-]' in that exact stuck state).
keybind = cmd+p=text:\x1d

# Cmd+T sends our tmux new-window key (see tmux.conf: user-keys[3] / User3)
# instead of opening a new Ghostty tab.
keybind = cmd+t=text:\x1et