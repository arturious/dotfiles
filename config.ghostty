theme = Solarized Dark Patched
background-opacity = 0.9
background-blur-radius = 20
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 14
shell-integration-features = no-cursor
cursor-style = block_hollow
cursor-style-blink = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1s
font-feature = ss02
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 1ms
macos-window-buttons = hidden
macos-titlebar-proxy-icon = visible
macos-icon = custom-style
macos-icon-frame = aluminum
macos-icon-ghost-color = #002b36
macos-icon-screen-color = #002b36
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

# Cmd+T sends our tmux prefix (Ctrl+Space = NUL byte) + "c" (default
# new-window binding) instead of opening a new Ghostty tab.
keybind = cmd+t=text:\x00c