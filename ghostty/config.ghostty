theme = Solarized Dark Patched
background-opacity = 0.8
background-blur = 100
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 14
shell-integration-features = no-cursor
cursor-style-blink = true
confirm-close-surface = false
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1s
font-feature = ss02
macos-titlebar-proxy-icon = hidden
title = " "
macos-titlebar-style = transparent
macos-icon = custom-style
macos-icon-ghost-color = #002b36
macos-icon-screen-color = #002b36
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = cmd+[=text:\x1ep
keybind = cmd+]=text:\x1en
# Cmd+Shift+[ / Cmd+Shift+] move the current tmux window left/right (see
# tmux/settings.conf: User3/User4). Written as [ and ], not bracket_left/right: only
# the same spelling replaces Ghostty's default previous_tab/next_tab.
keybind = cmd+shift+[=text:\x1eP
keybind = cmd+shift+]=text:\x1eN

# tmux prefix: Caps Lock tapped on its own sends F18 (Karabiner rule, Ghostty
# only; held, Caps Lock is Control), turned here into F12's escape sequence -
# the prefix tmux sees (see tmux/settings.conf). Not F12 straight from
# Karabiner: on a Mac keyboard that's volume up unless sent with Fn, and the
# Fn press set off whatever listens for Fn (Superwhisper's push-to-talk).
# Not F18 as the prefix itself: tmux only takes F1-F12.
keybind = f18=text:\x1b[24~

# Cmd+T sends our tmux new-window key (see tmux/settings.conf: User2)
# instead of opening a new Ghostty tab.
keybind = cmd+t=text:\x1et