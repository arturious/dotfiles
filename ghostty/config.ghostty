theme = Solarized Dark Patched
background-opacity = 0.8
background-blur = macos-glass-regular
background = #000000
font-family = "JetBrainsMono Nerd Font"
font-size = 13.5
font-feature = calt,cv02,cv03,cv04,cv05,cv06,cv07,cv11,cv14,cv16,cv17,cv18,cv19
shell-integration-features = no-cursor
cursor-style-blink = true
confirm-close-surface = false
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1s
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = transparent
macos-icon = custom-style
macos-icon-ghost-color = #002b36
macos-icon-screen-color = #002b36
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = f18=text:\x1b[24~
# No Ghostty tabs: these send private sequences that tmux binds (user-keys
# in tmux/settings.conf). Cmd+T new window, Cmd+[ / Cmd+] previous/next,
# Cmd+Shift+[ / Cmd+Shift+] move it. Written as [ and ], not bracket_left:
# only the same spelling replaces Ghostty's default previous_tab/next_tab.
keybind = cmd+t=text:\x1et
keybind = cmd+[=text:\x1ep
keybind = cmd+]=text:\x1en
keybind = cmd+shift+[=text:\x1eP
keybind = cmd+shift+]=text:\x1eN
# Cmd+1..9: tmux window N. Both spellings, like Ghostty's own goto_tab defaults.
keybind = cmd+1=text:\x1e1
keybind = cmd+digit_1=text:\x1e1
keybind = cmd+2=text:\x1e2
keybind = cmd+digit_2=text:\x1e2
keybind = cmd+3=text:\x1e3
keybind = cmd+digit_3=text:\x1e3
keybind = cmd+4=text:\x1e4
keybind = cmd+digit_4=text:\x1e4
keybind = cmd+5=text:\x1e5
keybind = cmd+digit_5=text:\x1e5
keybind = cmd+6=text:\x1e6
keybind = cmd+digit_6=text:\x1e6
keybind = cmd+7=text:\x1e7
keybind = cmd+digit_7=text:\x1e7
keybind = cmd+8=text:\x1e8
keybind = cmd+digit_8=text:\x1e8
keybind = cmd+9=text:\x1e9
keybind = cmd+digit_9=text:\x1e9
copy-on-select = clipboard
undo-timeout = 1s

