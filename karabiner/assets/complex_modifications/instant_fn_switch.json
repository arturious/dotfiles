    {
      "title": "Мгновенное переключение языка по Fn",
      "rules": [
        {
          "description": "Убрать задержку Fn (одиночное нажатие Fn мгновенно переключает язык)",            
          "manipulators": [
            {
              "type": "basic",
              "from": {
                "key_code": "fn",
                "modifiers": {
    		  "optional": ["any"]
                }
              },
              "to": [
                {
    		  "key_code": "fn"
                }
              ],
              "to_if_alone": [
                {
    		  "key_code": "space",
    		  "modifiers": ["left_control"]
                }
              ]
            }
          ]
        }
      ]
    }
