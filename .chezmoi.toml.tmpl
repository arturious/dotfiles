# `chezmoi init` renders this to ~/.config/chezmoi/chezmoi.toml.
# Keep the source where it was cloned (e.g. ~/dotfiles), not ~/.local/share/chezmoi.
sourceDir = {{ .chezmoi.sourceDir | quote }}

# `chezmoi edit <file>` opens the source file in Cursor and applies it once
# the Cursor tab is closed (--wait).
[edit]
    command = "/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
    args = ["--wait"]
    apply = true
